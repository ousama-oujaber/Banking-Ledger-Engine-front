{
  "name": "admin-console",
  "rootPath": "apps/admin-console",
  "sourceRoot": "apps/admin-console/src",
  "tags": ["scope:admin", "type:app"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng serve admin-console"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng build admin-console"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/admin-console/src"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'No tests yet for admin-console (scaffolded in S1-T7)'"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/admin-console/tsconfig.json --noEmit"
      }
    }
  }
}
