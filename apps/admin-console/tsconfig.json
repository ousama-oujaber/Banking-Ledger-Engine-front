{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["@types/node", "vitest/globals", "@testing-library/jest-dom"],
    "outDir": "../../dist/apps/admin-console",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@ble-frontend/domain-types": ["libs/domain-types/src/index.ts"],
      "@ble-frontend/api-client": ["libs/api-client/src/index.ts"],
      "@ble-frontend/auth": ["libs/auth/src/index.ts"],
      "@ble-frontend/tokens": ["libs/tokens/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.html",
    "angular.json",
    "proxy.conf.json",
    "vitest.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["node_modules", "tmp"]
}
