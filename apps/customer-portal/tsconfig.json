{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals", "@types/node", "@testing-library/jest-dom"],
    "outDir": "../../dist/apps/customer-portal",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "paths": {
      "@ble-frontend/domain-types": ["libs/domain-types/src/index.ts"],
      "@ble-frontend/api-client": ["libs/api-client/src/index.ts"],
      "@ble-frontend/auth": ["libs/auth/src/index.ts"],
      "@ble-frontend/tokens": ["libs/tokens/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "vitest.config.ts", "vitest.setup.ts"],
  "exclude": ["node_modules", "tmp"]
}
