{
  "name": "customer-portal",
  "rootPath": "apps/customer-portal",
  "sourceRoot": "apps/customer-portal/src",
  "tags": ["scope:cust", "type:app"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite apps/customer-portal"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build apps/customer-portal"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/customer-portal/vitest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/customer-portal/tsconfig.json --noEmit"
      }
    }
  }
}
