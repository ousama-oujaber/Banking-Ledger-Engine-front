{
  "name": "customer-portal",
  "rootPath": "apps/customer-portal",
  "sourceRoot": "apps/customer-portal/src",
  "tags": ["scope:cust", "type:app"],
  "targets": {
    "serve": {
      "executor": "@nx/vite:dev",
      "options": {
        "config": "apps/customer-portal/vite.config.ts"
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "options": {
        "config": "apps/customer-portal/vite.config.ts"
      },
      "configurations": {
        "production": {
          "configFile": "apps/customer-portal/vite.config.ts"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "config": "apps/customer-portal/vitest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:typescript"
    }
  }
}
