{
  "name": "auth",
  "rootPath": "libs/auth",
  "tags": ["scope:shared", "type:library"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/auth/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint libs/auth/src"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/auth/vitest.config.mjs"
      }
    }
  }
}
