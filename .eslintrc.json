{
  "root": true,
  "ignorePatterns": ["node_modules", "tmp"],
  "plugins": [],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module"
      },
      "rules": {
        "@typescript-eslint/no-explicit-any": "warn",
        "@typescript-eslint/no-unused-vars": "error"
      }
    }
  ]
}
